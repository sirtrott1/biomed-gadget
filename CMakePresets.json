      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      },
      "environment": {
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
        "MKL_NUM_THREADS": "1",
        "MPLBACKEND": "Agg"
      },
      "filter": {
        "exclude": {
          "label": "scale|recovery|local-inference"
        }
      }
    },
    {
      "name": "vulkan",
      "configurePreset": "vulkan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 1,
        "noTestsAction": "error"
      },
      "environment": {
        "OPENBLAS_NUM_THREADS": "1",
        "OMP_NUM_THREADS": "1",
