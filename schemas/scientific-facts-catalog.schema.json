{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.scientific.facts.catalog.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.scientific.facts.catalog.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "request": {
      "type": "object"
    },
    "context": {
      "type": "object"
    },
    "answers": {
      "type": "object"
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reference": {
            "type": "object"
          },
          "certificate": {
            "type": "object"
          }
        },
        "required": [
          "reference",
          "certificate"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "answer"
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "binding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "answer",
                  "binding",
                  "step",
                  "result"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "native"
                  },
                  "path": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "integer",
                          "minimum": 0
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "path"
                ],
                "additionalProperties": false
              }
            ]
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "value_type": {
            "enum": [
              "boolean",
              "count",
              "rational",
              "text",
              "integer"
            ]
          },
          "observed": {},
          "value": {},
          "owner": {
            "type": "object"
          },
          "fact_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "coordinate": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "meaning",
          "from",
          "path",
          "value_type",
          "observed",
          "value",
          "owner",
          "fact_sha256"
        ],
        "additionalProperties": false
      }
    },
    "facts_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_namespace": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "cutoff": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema",
    "source_digest",
    "question",
    "question_sha256",
    "request",
    "certificates",
    "facts",
    "facts_sha256"
  ],
  "additionalProperties": false
}
