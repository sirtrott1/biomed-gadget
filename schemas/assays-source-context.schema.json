{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.assays.source.context.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.assays.source.context.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "$ref": "#/$defs/target"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "document",
                "start",
                "end",
                "text"
              ]
            }
          }
        },
        "required": [
          "id",
          "target",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "source_digest",
    "question",
    "targets"
  ],
  "additionalProperties": false,
  "$defs": {
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "cell"
            },
            "assay": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "integer",
              "minimum": 0
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "assay",
            "partition",
            "source_digest",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "occurrence"
            },
            "assay": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "integer",
              "minimum": 0
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "grade": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "key": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "required": [
            "kind",
            "assay",
            "partition",
            "source_digest",
            "grade",
            "key"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "field"
            },
            "assay": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "integer",
              "minimum": 0
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "assay",
            "partition",
            "source_digest",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "context"
            },
            "assay": {
              "type": "string",
              "minLength": 1
            },
            "partition": {
              "type": "integer",
              "minimum": 0
            },
            "source_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "assay",
            "partition",
            "source_digest",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "resource"
            },
            "resource": {
              "type": "string",
              "minLength": 1
            },
            "artifact": {
              "enum": [
                "source",
                "reference"
              ]
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "record": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "resource",
            "artifact",
            "sha256"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
