{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.scientific.facts.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.scientific.facts.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "object"
    },
    "answers": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "source"
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "target"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "answer"
                  },
                  "answer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "binding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "step": {
                    "type": "string",
                    "minLength": 1
                  },
                  "result": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "kind",
                  "answer",
                  "binding",
                  "step",
                  "result"
                ],
                "additionalProperties": false
              }
            ]
          },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "value_type": {
            "enum": [
              "boolean",
              "count",
              "rational",
              "text",
              "integer"
            ]
          }
        },
        "required": [
          "id",
          "meaning",
          "from",
          "path",
          "value_type"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "source_digest",
    "question",
    "facts"
  ],
  "additionalProperties": false
}
