{
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.pipeline.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "const": "pipeline"
        },
        "profile": {
          "enum": [
            "rna_seq",
            "single_cell",
            "atac_seq",
            "chip_seq",
            "spatial",
            "multi_omics",
            "variants",
            "sequence",
            "custom"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "type": {
                "enum": [
                  "query",
                  "derive",
                  "workflow"
                ]
              },
              "input": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "uniqueItems": true
              },
              "assay": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "partition": {
                "type": "integer",
                "minimum": 0
              },
              "workers": {
                "type": "integer",
                "minimum": 1
              },
              "request_json": {
                "type": "string",
                "minLength": 2,
                "maxLength": 1024
              },
              "request": {
                "type": "object"
              },
              "recipe_binding": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9_-]+$",
                "not": {
                  "const": "source"
                }
              }
            },
            "required": [
              "id",
              "type",
              "input"
            ],
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "request"
                ],
                "not": {
                  "required": [
                    "request_json"
                  ]
                }
              },
              {
                "required": [
                  "request_json"
                ],
                "not": {
                  "required": [
                    "request"
                  ]
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema",
        "action",
        "source_digest",
        "profile",
        "question",
        "steps"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.pipeline.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "action": {
          "const": "clarify"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "schema",
        "action",
        "source_digest",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
