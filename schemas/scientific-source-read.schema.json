{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.scientific.source.read.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gadget.scientific.source.read.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "publication": {
      "type": "string",
      "minLength": 1
    },
    "source_sequence": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "stream": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "section": {
              "enum": [
                "fields",
                "cells",
                "occurrences",
                "contexts",
                "operators",
                "carriers",
                "documents",
                "field_sets",
                "publications"
              ]
            }
          },
          "required": [
            "kind",
            "section"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "document"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "field"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "operator"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "id"
          ]
        }
      ]
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema",
    "source_digest",
    "publication",
    "source_sequence",
    "stream",
    "offset",
    "limit"
  ]
}
