{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.homology.diagram.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product", "grade", "vertices", "arrows", "evidence"],
  "properties": {
    "schema": {"const": "gadget.homology.diagram.v1"},
    "product": {"enum": ["rational_zigzag", "integral_modules"]},
    "grade": {"type": "integer", "minimum": 0, "maximum": 65535},
    "evidence": {"type": "string", "minLength": 1},
    "vertices": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["source", "carriers"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "carriers": {"type": "array", "items": {"type": "integer", "minimum": 0}, "uniqueItems": true}
      }
    }},
    "arrows": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["forward", "maps"],
      "properties": {
        "forward": {"type": "boolean"},
        "maps": {"type": "array", "items": {"$ref": "#/$defs/map"}}
      }
    }}
  },
  "$defs": {
    "map": {
      "type": "object", "additionalProperties": false, "required": ["rows", "columns", "entries"],
      "properties": {
        "rows": {"type": "integer", "minimum": 0},
        "columns": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "items": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": ["string", "number"]}],
          "items": false
        }}
      }
    }
  }
}
