{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.pipeline.source.context.model.view.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.pipeline.source.context.model.view.v1"
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mentions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "mentions"
        ],
        "additionalProperties": false
      }
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "annotation_receipt_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "enum": [
              "asserted",
              "negated",
              "uncertain"
            ]
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "interpretation_verified": {
            "const": false
          }
        },
        "required": [
          "id",
          "target",
          "interpretation",
          "polarity",
          "binding_sha256",
          "interpretation_verified"
        ],
        "additionalProperties": false
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "$ref": "assays-source-context.schema.json#/$defs/target"
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "descriptor": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "target",
          "binding_sha256",
          "descriptor"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "requirements",
    "mapping_sha256",
    "annotation_receipt_sha256",
    "context_sha256",
    "question_sha256",
    "mentions",
    "targets"
  ],
  "additionalProperties": false
}
