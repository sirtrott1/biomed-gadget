{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.assays.annotation.proposal.v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.assays.annotation.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "question_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action": {
          "const": "annotate"
        },
        "mentions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "polarity": {
                "enum": [
                  "asserted",
                  "negated",
                  "uncertain"
                ]
              }
            },
            "required": [
              "id",
              "target",
              "interpretation",
              "polarity"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "source_digest",
        "context_sha256",
        "question_sha256",
        "action",
        "mentions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.assays.annotation.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "question_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "action": {
          "const": "clarify"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "source_digest",
        "context_sha256",
        "question_sha256",
        "action",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
