{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.semantic.proposal.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gadget.semantic.proposal.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "mentions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "polarity": {
            "enum": [
              "asserted",
              "negated",
              "uncertain"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/span"
            }
          }
        },
        "required": [
          "entity",
          "kind",
          "polarity",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schema",
    "source_digest",
    "mentions"
  ],
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document",
        "start",
        "end",
        "text"
      ]
    }
  }
}
