{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.pipeline.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.pipeline.v1"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "profile": {
      "enum": [
        "rna_seq",
        "single_cell",
        "atac_seq",
        "chip_seq",
        "spatial",
        "multi_omics",
        "variants",
        "sequence",
        "custom"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "type": {
            "enum": [
              "query",
              "derive",
              "workflow",
              "bind",
              "result",
              "statistics"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "request": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "uniqueItems": true
          },
          "assay": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "partition": {
            "type": "integer",
            "minimum": 0
          },
          "workers": {
            "type": "integer",
            "minimum": 1
          },
          "normalization_evidence_field": {
            "type": "string",
            "minLength": 1
          },
          "recipe_binding": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "not": {
              "const": "source"
            }
          },
          "result_input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "type",
          "input",
          "request"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "result"
                }
              }
            },
            "then": {
              "required": [
                "result_input"
              ],
              "properties": {
                "request": {
                  "$ref": "result-operation.schema.json"
                },
                "assay": false,
                "partition": false,
                "normalization_evidence_field": false
              }
            },
            "else": {
              "not": {
                "required": [
                  "result_input"
                ]
              }
            }
          }
        ]
      }
    },
    "concurrent_jobs": {
      "type": "integer",
      "minimum": 1
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "source_digest",
    "profile",
    "question",
    "steps"
  ],
  "additionalProperties": false
}
