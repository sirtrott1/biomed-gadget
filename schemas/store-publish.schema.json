{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.store.publish.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "transaction", "expected"],
  "properties": {
    "schema": {"const": "gadget.store.publish.v1"},
    "transaction": {"type": "string", "pattern": "^[1-9][0-9]{0,19}$", "description": "Nonzero uint64; runtime also enforces UINT64_MAX."},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "source_namespace", "generation", "sequence"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "source_namespace": {"type": "string", "const": "5134460123075575809"},
        "generation": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,3})$"},
        "sequence": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,3})$"}
      },
      "description": "Exact returned root; generation equals sequence and both are bounded by 1024."
    }
  }
}
