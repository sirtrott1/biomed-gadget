{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.scientific.plan.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "gadget.scientific.plan.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "query": {
            "$ref": "scientific-query.schema.json"
          }
        },
        "required": [
          "id",
          "query"
        ]
      }
    }
  },
  "required": [
    "schema",
    "id",
    "question",
    "source_digest",
    "steps"
  ]
}
