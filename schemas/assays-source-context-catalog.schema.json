{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.assays.source.context.catalog.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.assays.source.context.catalog.v1"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "question_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request": {
      "$ref": "assays-source-context.schema.json"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "$ref": "assays-source-context.schema.json#/$defs/target"
          },
          "resolved": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "target": {
                    "type": "object"
                  },
                  "descriptor": {
                    "type": "object"
                  },
                  "source_digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "native_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "source_namespace": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "document": {
                          "type": "string",
                          "minLength": 1
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "document_sha256": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "document",
                        "start",
                        "end",
                        "text",
                        "document_sha256"
                      ]
                    }
                  },
                  "target_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "target",
                  "descriptor",
                  "source_digest",
                  "native_sha256",
                  "source_namespace",
                  "evidence",
                  "target_sha256"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "descriptor": {
                    "type": "object"
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "document": {
                          "type": "string",
                          "minLength": 1
                        },
                        "start": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "end": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "document_sha256": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "document",
                        "start",
                        "end",
                        "text",
                        "document_sha256"
                      ]
                    }
                  }
                },
                "required": [
                  "descriptor",
                  "source_sha256",
                  "evidence"
                ],
                "additionalProperties": false
              }
            ]
          },
          "evidence_verified": {
            "const": true
          },
          "binding_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "id",
          "target",
          "resolved",
          "evidence_verified",
          "binding_sha256"
        ],
        "additionalProperties": false
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "source_digest",
    "question",
    "question_sha256",
    "request",
    "targets",
    "context_sha256"
  ],
  "additionalProperties": false
}
