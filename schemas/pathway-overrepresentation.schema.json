{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.pathways.overrepresentation.v1",
  "type": "object",
  "description": "A pinned native-record operation. Explicit feature-occurrence selectors, released source/mapping bytes, mapping policy, background, tested family and uniform-subset null are application declarations. actual_result template binding belongs to the outer pipeline wrapper; this producer always requires both archive pins.",
  "properties": {
    "schema": {
      "const": "gadget.pathways.overrepresentation.v1"
    },
    "operation": {
      "const": "pathway_overrepresentation"
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "gene_sets_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "feature_namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "features_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ]
      }
    },
    "feature_id_path": {
      "type": "array",
      "minItems": 0,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ]
      }
    },
    "background_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "selected_indices": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "uniqueItems": true
    },
    "mapping_policy": {
      "type": "object",
      "properties": {
        "ambiguous": {
          "enum": [
            "exclude",
            "refuse"
          ]
        },
        "unmapped": {
          "enum": [
            "exclude",
            "refuse"
          ]
        },
        "many_to_one": {
          "enum": [
            "refuse",
            "count_member_once"
          ]
        },
        "duplicate_occurrences": {
          "const": "retain_count_once"
        }
      },
      "required": [
        "ambiguous",
        "unmapped",
        "many_to_one",
        "duplicate_occurrences"
      ],
      "additionalProperties": false
    },
    "set_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "size_filter": {
      "type": "object",
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "const": "members_in_background"
        }
      },
      "required": [
        "minimum",
        "maximum",
        "basis"
      ],
      "additionalProperties": false
    },
    "membership_policy": {
      "type": "object",
      "properties": {
        "duplicates": {
          "const": "retain_count_once"
        },
        "empty": {
          "const": "retain_exclude"
        },
        "outside_background": {
          "const": "retain_exclude"
        }
      },
      "required": [
        "duplicates",
        "empty",
        "outside_background"
      ],
      "additionalProperties": false
    },
    "correction": {
      "enum": [
        "benjamini_hochberg",
        "benjamini_yekutieli",
        "bonferroni",
        "none"
      ]
    },
    "selection_method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "null_assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 64
    },
    "limits": {
      "type": "object",
      "properties": {
        "source_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "mapping_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "membership_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "sets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "features": {
          "type": "integer",
          "minimum": 1
        },
        "field_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "kernel_work": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "archive_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "declared_buffer_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "source_bytes",
        "mapping_rows",
        "membership_cells",
        "sets",
        "features",
        "field_bytes",
        "kernel_work",
        "archive_bytes",
        "declared_buffer_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "operation",
    "analysis_sha256",
    "gene_sets_sha256",
    "feature_namespace",
    "features_path",
    "feature_id_path",
    "background_indices",
    "selected_indices",
    "mapping_policy",
    "set_ids",
    "size_filter",
    "membership_policy",
    "correction",
    "selection_method",
    "null_assumptions",
    "limits"
  ],
  "additionalProperties": false
}
