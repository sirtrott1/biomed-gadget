{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific query sequence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assay"
  ],
  "properties": {
    "schema": {
      "const": "gadget.scientific.sequence.v1"
    },
    "assay": {
      "type": "string",
      "minLength": 1
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "query"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "query": {
            "type": "object"
          }
        }
      }
    },
    "context_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "methods",
        "restriction",
        "metric"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "local_sections",
              "green_action",
              "hodge",
              "adjoint"
            ]
          },
          "uniqueItems": true
        },
        "restriction": {
          "const": "scalar_identity"
        },
        "metric": {
          "const": "identity"
        },
        "green_lambda": {
          "type": "string"
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "queries"
      ]
    },
    {
      "required": [
        "context_template"
      ]
    }
  ]
}
