{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.pipeline.recipe.proposal.v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.pipeline.recipe.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "intent_sha256": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "recipes"
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schema",
        "source_digest",
        "intent_sha256",
        "action",
        "goals"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.pipeline.recipe.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "intent_sha256": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "const": "clarify"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "source_digest",
        "intent_sha256",
        "action",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
