{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.biomedical.collection.request.v1",
  "type": "object",
  "properties": {
    "schema": {"const": "gadget.biomedical.collection.request.v1"},
    "id": {"type": "string", "minLength": 1},
    "design": {"type": "object"},
    "assays": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$", "not": {"enum": [".", ".."]}}},
    "method": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_url": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1}
      },
      "required": ["id", "path", "sha256", "source_url", "license"],
      "additionalProperties": false
    }}
  },
  "required": ["schema", "id", "design", "assays", "method", "sources"],
  "additionalProperties": false
}
