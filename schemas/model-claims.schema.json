{
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.model.claims.v1"
    },
    "source_digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "certificate_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "minimum": 0
                }
              ]
            }
          },
          "value_type": {
            "enum": [
              "boolean",
              "count",
              "rational",
              "text",
              "integer"
            ]
          },
          "comparison": {
            "const": "equal"
          },
          "value": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "path",
          "value_type",
          "comparison",
          "value"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema",
    "source_digest",
    "certificate_sha256",
    "items"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.model.claims.v1"
}
