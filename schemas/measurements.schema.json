{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.measurements.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "context", "path", "identity_column", "fields"],
  "properties": {
    "schema": {"const": "gadget.measurements.v1"},
    "context": {"enum": ["AD", "HD"]},
    "path": {"type": "string", "minLength": 1},
    "delimiter": {"enum": [",", "\t"]},
    "identity_column": {"type": "string", "minLength": 1},
    "fields": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "column", "kind", "units", "method", "null_model", "missing_policy"],
        "properties": {
          "id": {"type": "string", "pattern": "^(AD|HD)\\..+$"},
          "column": {"type": "string", "minLength": 1},
          "kind": {"enum": ["measurement", "count", "effect_size", "standard_error", "p_value", "adjusted_p_value", "score", "probability", "binary_annotation"]},
          "units": {"type": "string"}, "method": {"type": "string", "minLength": 1},
          "null_model": {"type": "string"},
          "missing_policy": {"enum": ["reject", "zero_extension"]},
          "description": {"type": "string"}
        }
      }
    }
  }
}
