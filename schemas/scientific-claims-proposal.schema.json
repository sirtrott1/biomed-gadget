{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.scientific.claims.proposal.v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.scientific.claims.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "question_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "action": {
          "const": "claims"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "fact": {
                "type": "string",
                "minLength": 1
              },
              "comparison": {
                "enum": [
                  "equal",
                  "not_equal",
                  "greater",
                  "greater_equal",
                  "less",
                  "less_equal"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              }
            },
            "required": [
              "id",
              "fact",
              "comparison",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "source_digest",
        "facts_sha256",
        "question_sha256",
        "action",
        "claims"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "gadget.scientific.claims.proposal.v1"
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "facts_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "question_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "action": {
          "const": "clarify"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema",
        "source_digest",
        "facts_sha256",
        "question_sha256",
        "action",
        "reason"
      ],
      "additionalProperties": false
    }
  ]
}
