{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gadget.features.evidence-context.request.v1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "gadget.features.evidence-context.request.v1"
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "mapping_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "evidence_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "feature_path": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ]
      },
      "minItems": 1
    },
    "feature_id_path": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "integer",
            "minimum": 0
          }
        ]
      }
    },
    "assertion_keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[1-9][0-9]*$"
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "properties": {
        "source_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "features": {
          "type": "integer",
          "minimum": 1
        },
        "mapping_rows": {
          "type": "integer",
          "minimum": 1
        },
        "assertions": {
          "type": "integer",
          "minimum": 1
        },
        "participants": {
          "type": "integer",
          "minimum": 1
        },
        "matches": {
          "type": "integer",
          "minimum": 1
        },
        "work": {
          "type": "integer",
          "minimum": 1
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_bytes",
        "features",
        "mapping_rows",
        "assertions",
        "participants",
        "matches",
        "work",
        "output_bytes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "analysis_sha256",
    "mapping_sha256",
    "evidence_digest",
    "feature_path",
    "feature_id_path",
    "assertion_keys",
    "question",
    "limits"
  ],
  "additionalProperties": false
}
