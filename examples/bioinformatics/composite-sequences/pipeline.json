{
  "schema": "gadget.pipeline.default.v1",
  "profile": "sequence",
  "question": "Discover complete exon chains and compare literal read reconstructions and observed structure",
  "goals": [
    {
      "method": "sequence_splice_discovery",
      "parameters": {
        "query_resource": "queries",
        "reference_resource": "reference",
        "strands": [
          "+",
          "-"
        ],
        "minimum_exon_bases": 3,
        "minimum_intron_bases": 4,
        "maximum_intron_bases": 10,
        "maximum_junctions": 6,
        "motifs": [
          "GT-AG"
        ],
        "evidence": "Complete exact exon chains from the retained reference"
      }
    },
    {
      "method": "read_overlap_reconstruction",
      "parameters": {
        "resource": "reads",
        "minimum_overlap": 2,
        "objective": "minimum_suffix_prefix_read_cover",
        "evidence": "Every original read in its retained orientation"
      }
    },
    {
      "method": "sequence_assembly_graph",
      "parameters": {
        "resource": "reads",
        "k": 3,
        "ambiguity": "literal_tokens",
        "evidence": "Every source literal k-mer occurrence"
      }
    }
  ]
}
