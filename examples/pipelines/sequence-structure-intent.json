        "parameters": {
          "context": "all",
          "grade": 1,
          "coefficient_domain": "rational",
          "field": "all.kmer_occurrence_count"
        }
      }
    },
    {
      "id": "response",
      "purpose": "Compute the full Green response on the observed source",
      "goal": {
        "method": "green_action",
        "input": "assembly",
        "parameters": {
