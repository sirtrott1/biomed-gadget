            "evidence": "Replace with the experimental evidence for these coefficients and units",
            "entries": [
              {
                "left_id": "gene_A",
                "right_id": "protein_A",
                "coefficient": "1/2"
              },
              {
                "left_id": "gene_B",
                "right_id": "protein_B",
                "coefficient": "1"
              }
            ]
          }
        }
      }
    }
  ]
