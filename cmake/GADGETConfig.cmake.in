@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@GADGET_ENABLE_VULKAN@)
  find_dependency(RFC 0.3.0 CONFIG COMPONENTS Vulkan)
else()
  find_dependency(RFC 0.3.0 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/GADGETVerifyRFC.cmake")
gadget_verify_rfc("${CMAKE_CURRENT_LIST_DIR}/GADGETRFCHeaders.sha256" _gadget_pin_error)
if(_gadget_pin_error)
  set(GADGET_FOUND FALSE)
  set(GADGET_NOT_FOUND_MESSAGE "${_gadget_pin_error}")
  return()
endif()
find_dependency(Threads)
set(GADGET_native_FOUND TRUE)
set(GADGET_core_FOUND TRUE)
set(_gadget_core_required FALSE)
if(NOT GADGET_FIND_COMPONENTS OR "core" IN_LIST GADGET_FIND_COMPONENTS)
  set(_gadget_core_required TRUE)
endif()
if(_gadget_core_required)
  find_dependency(OpenSSL COMPONENTS Crypto)
  find_dependency(PkgConfig)
  pkg_check_modules(JSONC REQUIRED IMPORTED_TARGET json-c)
  if(@GADGET_ENABLE_HTSLIB@)
    pkg_check_modules(HTSLIB REQUIRED IMPORTED_TARGET "htslib>=1.20")
  endif()
  if(@GADGET_ENABLE_HDF5@)
    pkg_check_modules(HDF5 REQUIRED IMPORTED_TARGET "hdf5>=1.12")
  endif()
  if(@GADGET_ENABLE_PUBLIC_DATABASES@)
    pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
  endif()
endif()
unset(_gadget_core_required)
include("${CMAKE_CURRENT_LIST_DIR}/GADGETTargets.cmake")
check_required_components(GADGET)
