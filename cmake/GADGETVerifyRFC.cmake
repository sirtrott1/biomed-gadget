# Exact public header contract for installed consumers.
# The native core's semantic version alone does not identify this source snapshot.
function(gadget_verify_rfc manifest result)
  set(${result} "" PARENT_SCOPE)
  if(NOT TARGET rfc::core)
    set(${result} "RFC did not provide rfc::core" PARENT_SCOPE)
    return()
  endif()
  get_target_property(_includes rfc::core INTERFACE_INCLUDE_DIRECTORIES)
  set(_roots)
  foreach(_entry IN LISTS _includes)
    if(_entry MATCHES "^\\$<BUILD_INTERFACE:(.*)>$")
      set(_entry "${CMAKE_MATCH_1}")
    elseif(_entry MATCHES "^\\$<")
      continue()
    endif()
    if(EXISTS "${_entry}/rfc/core/relational_complex.hpp")
      file(REAL_PATH "${_entry}" _entry)
      list(APPEND _roots "${_entry}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _roots)
  list(LENGTH _roots _count)
  if(NOT _count EQUAL 1)
    set(${result} "RFC must expose exactly one resolvable native public include root" PARENT_SCOPE)
    return()
  endif()
  list(GET _roots 0 _root)
  file(STRINGS "${manifest}" _records)
  set(_expected)
  foreach(_record IN LISTS _records)
    if(NOT _record MATCHES "^([0-9a-f]+)  (rfc/[^;]+[.]hpp)$")
      set(${result} "Invalid GADGET RFC header manifest" PARENT_SCOPE)
      return()
    endif()
    set(_hash "${CMAKE_MATCH_1}")
    set(_name "${CMAKE_MATCH_2}")
    list(APPEND _expected "${_name}")
    if(NOT EXISTS "${_root}/${_name}")
      set(${result} "RFC source pin mismatch: missing ${_name}" PARENT_SCOPE)
      return()
    endif()
    file(SHA256 "${_root}/${_name}" _found)
    if(NOT _found STREQUAL _hash)
      set(${result} "RFC source pin mismatch: ${_name}; rebuild GADGET against the intended core snapshot" PARENT_SCOPE)
      return()
    endif()
  endforeach()
  file(GLOB_RECURSE _actual RELATIVE "${_root}" "${_root}/rfc/*.hpp")
  list(SORT _actual)
  list(SORT _expected)
  if(NOT _actual STREQUAL _expected)
    set(${result} "RFC source pin mismatch: public header set differs" PARENT_SCOPE)
  endif()
endfunction()
